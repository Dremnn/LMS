<%@ page pageEncoding="UTF-8" %>
<style>
/* User Profile Navbar Dropdown */
.user-dropdown {
    position: relative;
    display: inline-flex;
    align-items: center;
}
.user-dropdown .user-badge {
    cursor: pointer;
    user-select: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-right: 12px;
}
.user-dropdown:hover .user-badge {
    border-color: #076FA4;
    background: rgba(7, 111, 164, 0.08);
}
.user-dropdown-chevron {
    font-size: 11px;
    margin-left: 4px;
    transition: transform 0.2s ease;
    color: #5C7688;
}
.user-dropdown:hover .user-dropdown-chevron {
    transform: rotate(180deg);
    color: #076FA4;
}
.user-dropdown-menu {
    display: none !important;
    position: absolute !important;
    top: calc(100% + 6px) !important;
    right: 0 !important;
    min-width: 200px !important;
    background: #ffffff !important;
    border: 1px solid #C6D8E3 !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 28px rgba(9, 60, 98, 0.16) !important;
    padding: 8px 6px !important;
    flex-direction: column !important;
    gap: 4px !important;
    z-index: 99999 !important;
}
/* Cầu nối hover chống chớp tắt khi rê chuột xuống */
.user-dropdown-menu::before {
    content: '' !important;
    position: absolute !important;
    top: -10px !important;
    left: 0 !important;
    right: 0 !important;
    height: 10px !important;
    background: transparent !important;
}
.user-dropdown:hover .user-dropdown-menu,
.user-dropdown-menu:hover,
.user-dropdown:focus-within .user-dropdown-menu {
    display: flex !important;
}
.user-dropdown-item {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 10px 14px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #093C62 !important;
    text-decoration: none !important;
    border-radius: 8px !important;
    transition: all 0.15s ease !important;
    white-space: nowrap !important;
}
.user-dropdown-item i {
    font-size: 15px !important;
    width: 20px !important;
    text-align: center !important;
    color: #076FA4 !important;
}
.user-dropdown-item:hover {
    background: rgba(7, 111, 164, 0.08) !important;
    color: #076FA4 !important;
    transform: translateX(3px) !important;
}
/* Dark theme */
body.dark-theme .user-dropdown-menu {
    background: #182535 !important;
    border-color: #093C62 !important;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6) !important;
}
body.dark-theme .user-dropdown-item {
    color: #F4F8FA !important;
}
body.dark-theme .user-dropdown-item:hover {
    background: rgba(7, 111, 164, 0.25) !important;
    color: #38BDF8 !important;
}
body.dark-theme .user-dropdown-item i {
    color: #38BDF8 !important;
}
body.dark-theme .user-dropdown-chevron {
    color: #9DB9CB !important;
}
body.dark-theme .user-dropdown:hover .user-dropdown-chevron {
    color: #38BDF8 !important;
}

/* Wallet Badge on Navbar */
.wallet-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    background: rgba(16, 185, 129, 0.1) !important;
    color: #059669 !important;
    border: 1px solid rgba(16, 185, 129, 0.3) !important;
    padding: 6px 14px !important;
    border-radius: 50px !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    cursor: pointer !important;
    white-space: nowrap !important;
}
.wallet-badge i {
    font-size: 14px !important;
    color: #10B981 !important;
}
.wallet-badge:hover {
    background: rgba(16, 185, 129, 0.18) !important;
    border-color: #10B981 !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2) !important;
    color: #047857 !important;
}
body.dark-theme .wallet-badge {
    background: rgba(16, 185, 129, 0.15) !important;
    color: #34D399 !important;
    border-color: rgba(16, 185, 129, 0.4) !important;
}
body.dark-theme .wallet-badge:hover {
    background: rgba(16, 185, 129, 0.25) !important;
    color: #6EE7B7 !important;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
}

/* Wallet Item inside Dropdown */
.wallet-dropdown-item {
    border-bottom: 1px solid rgba(198, 216, 227, 0.6) !important;
    padding-bottom: 10px !important;
    margin-bottom: 4px !important;
}
.wallet-dropdown-balance {
    margin-left: auto !important;
    color: #10B981 !important;
    font-weight: 700 !important;
    font-size: 13px !important;
}
body.dark-theme .wallet-dropdown-item {
    border-bottom-color: rgba(9, 60, 98, 0.6) !important;
}
body.dark-theme .wallet-dropdown-balance {
    color: #34D399 !important;
}
</style>
